# ScamShield AI Backend Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit the .env file to version control.

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Actian VectorAI / Actian Vector Database Configuration
ACTIAN_HOST=localhost
ACTIAN_PORT=27839
ACTIAN_DATABASE=scamshield_vectors
ACTIAN_USER=actian
ACTIAN_PASSWORD=your_actian_password_here
ACTIAN_TABLE_NAME=merchant_vectors
ACTIAN_ENABLED=true

# Application Security
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","*"]

